{
  "name": "workspace",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.unit.mjs scripts/admin",
    "capture": "CAPTURE=1 playwright test tests/visual",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "check:names": "node redesign/check-old-names.js",
    "check:app-name": "node redesign/check-app-name.js",
    "test:emu": "node scripts/emu/test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-workspace \"node --test tests/rules/*.test.mjs\"",
    "rules:deploy": "node scripts/admin/rules-preflight.mjs && firebase deploy --only firestore:rules --project greg-project-5b838"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.48.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1"
  }
}
